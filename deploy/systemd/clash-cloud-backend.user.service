[Unit]
Description=Clash Cloud backend on AC
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.local/share/clash-cloud/app.env
ExecStart=%h/.local/opt/clash-cloud/current/clash-cloud
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/clash-cloud

[Install]
WantedBy=default.target
