# Include map and log_format in the http {} context.
map $uri $clash_cloud_log_uri {
    default $uri;
    ~^/s/[^/]+$ /s/[token-redacted];
}

log_format clash_cloud '$remote_addr [$time_local] '
                       '"$request_method $clash_cloud_log_uri $server_protocol" '
                       '$status $body_bytes_sent';

# Add these locations inside the existing TLS server block. Keep the API
# authentication include mandatory and point it at the site's approved admin
# authentication mechanism.
location ^~ /api/v1/ {
    include /etc/nginx/snippets/clash-cloud-admin-auth.conf;
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

# The opaque output token in the path is the only authorization for this route.
# Do not pass browser admin credentials upstream.
location ^~ /s/ {
    auth_basic off;
    auth_request off;
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization "";
}

# Replace other server- and location-level access logs for this host so this redacted format is the only access log.
access_log /var/log/nginx/clash-cloud.access.log clash_cloud;
