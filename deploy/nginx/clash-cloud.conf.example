# Public TLS ingress for Clash Cloud. Add to the tx Nginx sites-enabled set
# after replacing both copies of the ingress-header value with one random secret.
# The matching loopback-only FRP destination is in clash-cloud-internal.conf.example.
server {
    listen 80;
    listen [::]:80;
    server_name clash-cloud.chenkeyan.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location ^~ /s/ {
        access_log off;
        return 301 https://$host$request_uri;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name clash-cloud.chenkeyan.com;

    ssl_certificate /etc/letsencrypt/live/clash-cloud.chenkeyan.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/clash-cloud.chenkeyan.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location ^~ /s/ {
        auth_basic off;
        access_log off;
        proxy_pass http://127.0.0.1:8007;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Clash-Cloud-Ingress replace-with-shared-random-ingress-secret;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
    }

    # OAuth callback query strings contain a one-time authorization code.
    # Do not place them in the access log or clear the browser session cookie.
    location ^~ /auth/ {
        access_log off;
        proxy_pass http://127.0.0.1:8007;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Clash-Cloud-Ingress replace-with-shared-random-ingress-secret;
        proxy_set_header Authorization "";
        proxy_read_timeout 45s;
    }

    location / {
        proxy_pass http://127.0.0.1:8007;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Clash-Cloud-Ingress replace-with-shared-random-ingress-secret;
        proxy_set_header Authorization "";
    }

    access_log /var/log/nginx/clash-cloud.access.log combined;
    error_log /var/log/nginx/clash-cloud.error.log warn;
}
