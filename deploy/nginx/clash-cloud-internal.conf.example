# Loopback-only destination registered in tx FRPS by clash-cloud-frpc.ini.example.
# Use the same random ingress-header value as the public TLS vhost.
server {
    listen 127.0.0.1:18080;
    server_name clash-cloud.chenkeyan.com;

    if ($http_x_clash_cloud_ingress != "replace-with-shared-random-ingress-secret") {
        return 403;
    }

    root /opt/clash-cloud/current/web/dist;
    index index.html;

    location ^~ /api/v1/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
    }

    location ^~ /s/ {
        access_log off;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
    }

    location ~* \.(js|css|woff2?|ttf|svg|ico|png|jpe?g|gif|webp)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
